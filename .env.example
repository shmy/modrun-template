# HTTP
LISTEN_ADDR=0.0.0.0:8080
MASTER=true
APP_ENV=development
REQUEST_TIMEOUT=60s
BODY_LIMIT_BYTES=2097152
SCALAR_UI_ENABLED=true
# 逗号分隔可信代理 IP/CIDR；Ingress/Nginx 后需配置其网段，否则限流按代理 IP 计
TRUSTED_PROXIES=
# 逗号分隔浏览器 Origin；空=不加 CORS 层（纯 API / 反代场景）
CORS_ORIGINS=

# JWT / identity（JWT_SECRET 必填，无程序内默认值）
JWT_SECRET=dev-only-jwt-secret-at-least-32-bytes!!
JWT_ISSUER=modrun-template
JWT_AUDIENCE=account
ACCESS_TOKEN_TTL=15min
REFRESH_TOKEN_TTL=30d
SEED_ADMIN_PHONE=13888888888
SEED_ADMIN_PASSWORD=admin123!

# Logging / tracing
RUST_LOG=info
# 空字符串关闭 OTLP 导出（仅 console）；有 collector 时再填如 http://localhost:4317
OTLP_ENDPOINT=
OTLP_SERVICE_NAME=modrun-template
OTLP_METADATA={}
# Trace 采样率 (0, 1]；1=全量。默认 0.1 降低 collector 负载
OTLP_SAMPLER_RATIO=0.1

# PostgreSQL（编译 sqlx 宏时也需要可连通的 DATABASE_URL）
# 容量规划：实例数 × DATABASE_MAX_CONNECTIONS ≤ PostgreSQL max_connections 预算（预留管理连接）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/modrun_template

# axum-governor 全局限流（按客户端 IP；登录/刷新路由另有更紧配额）
RATE_LIMIT_GLOBAL_PER_SECOND=100
RATE_LIMIT_GLOBAL_BURST=200
RATE_LIMIT_AUTH_PER_SECOND=5
RATE_LIMIT_AUTH_BURST=10

# 缓存 cache-redb（编译 feature：cache-redb）
CACHE_REDB_PATH=data/cache.redb

# 缓存 cache-redis（编译 feature：cache-redis）
CACHE_REDIS_URL=redis://127.0.0.1:6379

# 缓存 cache-pg 使用 DATABASE_URL（见上）

# Job 队列 job-queue-sqlite（编译 feature：job-queue-sqlite）
JOB_QUEUE_SQLITE_PATH=worker.db

# Job 队列 job-queue-pg 使用 DATABASE_URL（见上）

# 对象存储 blob-fs（编译 feature：blob-fs）
BLOB_FILE_ROOT=data/blob
BLOB_FILE_DOMAIN=http://localhost:8080/files

# 对象存储 blob-cos（编译 feature：blob-cos，默认）
BLOB_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
BLOB_S3_BUCKET=modrun-template
BLOB_S3_DOMAIN=http://localhost:8080/files
BLOB_S3_SECRET_ID=
BLOB_S3_SECRET_KEY=

DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_LIFETIME=15min
DATABASE_IDLE_TIMEOUT=5min
DATABASE_ACQUIRE_TIMEOUT=5s
